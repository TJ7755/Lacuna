{
  "name": "lacuna",
  "private": true,
  "version": "0.2.3",
  "packageManager": "bun@1.4.0",
  "type": "module",
  "main": "electron/dist-electron/main.js",
  "description": "Lacuna - a local-only FSRS-6 flashcard revision application.",
  "author": "TJ7755",
  "homepage": "https://github.com/TJ7755/Lacuna#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TJ7755/Lacuna.git"
  },
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "bun run typecheck && vite build",
    "preview": "bun run build && vite preview",
    "typecheck": "bun run typecheck:web && bun run typecheck:electron",
    "typecheck:web": "tsc -b --noEmit",
    "typecheck:electron": "tsc -p electron/tsconfig.json --noEmit && tsc -p electron/tsconfig.preload.json --noEmit && tsc -p electron/tsconfig.mcp.json --noEmit",
    "typecheck:ai-mcp": "bun run --cwd tooling/lacuna-ai-mcp typecheck",
    "test": "vitest run",
    "test:ci:unit": "vitest run --maxWorkers=1 --minWorkers=1",
    "test:ai-mcp": "bun run --cwd tooling/lacuna-ai-mcp test",
    "test:coverage": "vitest run src/course/path.test.ts src/course/unlock.test.ts src/fsrs/session.test.ts src/db/lineageDiff.test.ts --coverage --maxWorkers=1 --minWorkers=1",
    "test:coverage:recovery": "vitest run --config vitest.recovery.config.ts --coverage --maxWorkers=1 --minWorkers=1",
    "test:e2e:web": "playwright test -c playwright.web.config.ts",
    "test:e2e:electron-ai": "bun run electron:prepare && playwright test -c playwright.electron-ai.config.ts",
    "perf:audit": "bun scripts/performance-audit.ts",
    "perf:audit:web-interactions": "playwright test -c playwright.web.config.ts tests/e2e/first-interaction-latency.spec.ts --project=chromium --workers=1",
    "perf:audit:electron-package": "bun scripts/electron-package-audit.ts",
    "perf:check:electron-package": "bun scripts/electron-package-audit.ts --asar release/win-unpacked/resources/app.asar --check",
    "perf:check": "bun scripts/performance-audit.ts --assets-only",
    "build:assets": "vite build",
    "test:watch": "vitest",
    "lint": "eslint src electron --ext .ts,.tsx",
    "lint:ai-mcp": "bun run --cwd tooling/lacuna-ai-mcp lint",
    "lint:fix": "eslint src electron --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,css}\" \"*.cjs\" \".prettierrc\" \".eslintignore\"",
    "build:mcp": "node electron/mcp/build.mjs",
    "smoke:ai-mcp": "node scripts/ai-mcp-smoke.mjs",
    "build:ai-mcp": "bun run --cwd tooling/lacuna-ai-mcp build",
    "ai:mcp": "node tooling/lacuna-ai-mcp/dist/index.js",
    "release:scenario": "node scripts/release-scenario.mjs",
    "icons:generate": "bun scripts/generate-icons.ts",
    "electron:prepare": "node scripts/prepare-electron-build.mjs",
    "electron:dev": "bun run electron:prepare && concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "bun run electron:prepare && vite build --mode production --base ./ && electron-builder --config electron/electron-builder.yml --publish never",
    "electron:build:win": "bun run electron:prepare && vite build --mode production --base ./ && electron-builder --win --x64 --config electron/electron-builder.yml --publish never",
    "electron:build:linux": "bun run electron:prepare && vite build --mode production --base ./ && electron-builder --linux --x64 --config electron/electron-builder.yml --publish never",
    "electron:build:mac": "bun run electron:prepare && vite build --mode production --base ./ && electron-builder --mac --arm64 --config electron/electron-builder.yml --publish never"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "zod": "4.2.0"
  },
  "overrides": {
    "nanoid": "3.3.18",
    "@emnapi/core": "1.7.1",
    "@emnapi/runtime": "1.7.1",
    "@napi-rs/wasm-runtime": "1.1.0"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@modelcontextprotocol/client": "2.0.0",
    "@napi-rs/wasm-runtime": "1.1.0",
    "@open-spaced-repetition/binding": "^0.4.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "4.1.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^15.0.7",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/sql.js": "^1.4.11",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vercel/analytics": "^2.0.1",
    "@vitejs/plugin-react-swc": "^4.3.1",
    "@vitest/coverage-v8": "3.2.7",
    "concurrently": "^8.2.2",
    "dexie": "^4.0.10",
    "dexie-react-hooks": "^1.1.7",
    "electron": "^42.11.0",
    "electron-builder": "^26.15.7",
    "esbuild": "^0.25.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "fake-indexeddb": "^6.2.5",
    "fflate": "^0.8.3",
    "happy-dom": "^20.10.2",
    "highlight.js": "^11.10.0",
    "html5-qrcode": "^2.3.8",
    "katex": "^0.16.11",
    "mathjs": "^15.2.0",
    "motion": "^11.15.0",
    "prettier": "^3.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "react-qr-code": "^2.2.0",
    "react-router-dom": "^6.30.6",
    "recharts": "^2.13.3",
    "rehype-highlight": "^7.0.1",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "sharp": "^0.35.3",
    "sql.js": "^1.14.1",
    "tailwindcss": "4.1.18",
    "ts-fsrs": "^5.2.3",
    "typescript": "^5.6.3",
    "vite": "^6.4.3",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "3.2.7",
    "wait-on": "^7.2.0"
  }
}
