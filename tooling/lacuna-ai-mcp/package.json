{
  "name": "@lacuna/ai-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "lacuna-ai-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --external:@modelcontextprotocol/server --external:'@modelcontextprotocol/server/*' --external:zod --outfile=dist/index.js --banner:js='#!/usr/bin/env node'",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run -c vitest.config.ts",
    "typecheck": "bun check -p tsconfig.json"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "5.0.5"
  }
}
