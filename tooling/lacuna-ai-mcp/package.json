{
  "name": "@lacuna/ai-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "lacuna-ai-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --external:@modelcontextprotocol/server --external:'@modelcontextprotocol/server/*' --external:zod --outfile=dist/index.js --banner:js='#!/usr/bin/env node'",
    "lint": "eslint src --ext .ts",
    "test": "vitest run -c vitest.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "zod": "4.2.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.3",
    "vitest": "2.1.9"
  }
}
