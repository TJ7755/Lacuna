  "commandWords": [
    {
      "word": "Add/Label",
      "meaning": "Annotate the supplied material with the requested details or labels."
    },
    {
      "word": "Calculate",
      "meaning": "Work out a numerical result and include the steps used."
    },
    {
      "word": "Comment on",
      "meaning": "Combine relevant variables or evidence to reach a judgement."
    },
    {
      "word": "Complete",
      "meaning": "Fill the missing parts of the supplied table or diagram."
    },
    {
      "word": "Deduce",
      "meaning": "Infer a conclusion using the information supplied."
    },
    {
      "word": "Describe",
      "meaning": "Develop an account of the relevant features without needing reasons."
    },
    {
      "word": "Determine",
      "meaning": "Use the supplied material to establish an answer with a quantitative element."
    },
    {
      "word": "Design",
      "meaning": "Devise a procedure using the relevant scientific principles."
    },
    {
      "word": "Discuss",
      "meaning": "Identify the issue and reason through its different aspects and arguments."
    },
    {
      "word": "Draw",
      "meaning": "Represent the requested object or process in a diagram, ruled or freehand."
    },
    {
      "word": "Estimate",
      "meaning": "Use data, a diagram or calculation to give an approximate quantity."
    },
    {
      "word": "Evaluate",
      "meaning": "Weigh evidence, strengths, weaknesses and alternatives to make a justified contextual judgement."
    },
    {
      "word": "Explain",
      "meaning": "Support the point with reasons or illustrative evidence, which may be mathematical."
    },
    {
      "word": "Give/State/Name",
      "meaning": "Recall the requested facts or information."
    },
    {
      "word": "Give a reason/reasons",
      "meaning": "Supply the reasons behind the statement provided."
    },
    {
      "word": "Identify",
      "meaning": "Select the relevant feature or information from the supplied material."
    },
    {
      "word": "Justify",
      "meaning": "Support the stated claim or your earlier response with evidence."
    },
    {
      "word": "Plot",
      "meaning": "Mark the supplied data accurately, use suitable scales and axis labels, and add a best-fit line."
    },
    {
      "word": "Predict",
      "meaning": "State the outcome you expect."
    },
    {
      "word": "Show that",
      "meaning": "Demonstrate that the supplied claim holds."
    },
    {
      "word": "Sketch",
      "meaning": "Draw freehand; for graphs, label axes and key features without requiring a scaled axis."
    },
    {
      "word": "State what is meant by",
      "meaning": "Express the meaning of the term in suitable words."
    },
    {
      "word": "Suggest",
      "meaning": "Apply what you know to propose an answer in an unfamiliar situation."
    },
    {
      "word": "Analyse the data/graph to explain",
      "meaning": "Inspect the supplied data or graph closely and use it to explain the result."
    },
    {
      "word": "What, Why, Which",
      "meaning": "Choose the appropriate response in a multiple-choice question."
    }
  ],
