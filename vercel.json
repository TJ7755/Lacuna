{
  "framework": "vite",
  "installCommand": "bunx bun@1.4.3 install --frozen-lockfile",
  "buildCommand": "bunx bun@1.4.3 run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Cross-Origin-Embedder-Policy",
          "value": "require-corp"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://scripts.simpleanalyticscdn.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' blob: data: https://queue.simpleanalyticscdn.com; media-src 'self' blob:; connect-src 'self' https://queue.simpleanalyticscdn.com https://relay.getlacuna.app https://lacuna-relay.vercel.app https://getlacuna.app; frame-src 'self' https://www.youtube-nocookie.com https://player.vimeo.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self';"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/films/lacuna-student-4k.mp4",
      "headers": [
        {
          "key": "x-vercel-enable-rewrite-caching",
          "value": "0"
        }
      ]
    },
    {
      "source": "/films/gaps-teachers-tutors-4k.mp4",
      "headers": [
        {
          "key": "x-vercel-enable-rewrite-caching",
          "value": "0"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/compare/quizlet",
      "destination": "/compare/quizlet/",
      "permanent": true
    },
    {
      "source": "/compare/quizlet/index.html",
      "destination": "/compare/quizlet/",
      "permanent": true
    },
    {
      "source": "/courses",
      "destination": "/courses/",
      "permanent": true
    },
    {
      "source": "/courses/index.html",
      "destination": "/courses/",
      "permanent": true
    },
    {
      "source": "/courses/:id/index.html",
      "destination": "/courses/:id/",
      "permanent": true
    },
    {
      "source": "/courses/:id",
      "destination": "/courses/:id/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/films/lacuna-student-4k.mp4",
      "destination": "https://chpeihgcobr0gvsi.public.blob.vercel-storage.com/films/2026-10/lacuna-student-4k.mp4"
    },
    {
      "source": "/films/gaps-teachers-tutors-4k.mp4",
      "destination": "https://chpeihgcobr0gvsi.public.blob.vercel-storage.com/films/2026-10/gaps-teachers-tutors-4k.mp4"
    }
  ]
}
