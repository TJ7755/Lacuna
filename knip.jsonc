{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": ["check", "fmt"],
  "workspaces": {
    ".": {
      // Invoked by filename in Electron preparation; Tailwind is loaded through CSS.
      "ignoreDependencies": ["@typescript/native", "tailwindcss"],
      "entry": [
        "apps/web/src/pages/{quizlet,courses}/entry-client.tsx",
        "apps/web/src/{teacher,library}/main.tsx",
        "apps/web/src/pages/{landing,quizlet,courses}/entry-server.tsx",
        "apps/ai/api/ai/*.ts",
        "apps/desktop/{main,preload}.ts",
        "apps/desktop/mcp/{server,companion,aiCompanion,aiCompanionEntry}.ts",
        "apps/web/src/workers/*.worker.ts",
        "apps/web/src/fsrs/wasi-worker-browser.mjs",
        "apps/web/src/{vite-env,testing}.d.ts",
        "apps/desktop/updaterContract.d.ts",
        "apps/gaps/sw.js",
        "scripts/{ai-benchmark,jev-smoke,question-bank,library-publish}.ts",
        "scripts/performance-heavy/{fixture,run}.ts",
        "scripts/performance-heavy/{summarise,trace-summary}.mjs",
        "tooling/semantic-answer-match/scripts/compare_answer_baseline.ts",
        "scripts/**/*.test.mjs",
        "tests/config/{playwright.*,vitest.recovery,vitest.risk}.config.ts",
        "tests/e2e/**/*.spec.ts",
        "tests/e2e-electron/**/*.spec.ts",
      ],
      "project": [
        "*.{js,mjs,cjs,ts,mts,cts}",
        "{apps,packages,scripts,tests}/**/*.{js,mjs,cjs,ts,tsx,mts,cts,css}",
        "tooling/semantic-answer-match/scripts/*.ts",
        "!apps/desktop/dist-electron/**",
      ],
      "vite": {
        "config": ["vite.config.ts", "vite.gaps.config.ts", "vite.library.config.ts"],
      },
    },
    "apps/relay": {
      "entry": ["apps/ai/api/index.ts", "tests/**/*.test.ts"],
      "project": ["{src,api,shared,tests,scripts}/**/*.{ts,mjs}", "*.{ts,mjs}"],
    },
    "tooling/handwriting-maths": {
      "entry": ["apps/web/src/**/*.test.ts"],
      "project": ["apps/web/src/**/*.ts", "*.ts"],
    },
    "tooling/lacuna-ai-mcp": {
      "entry": ["apps/web/src/index.ts", "apps/web/src/**/*.test.ts"],
      "project": ["apps/web/src/**/*.ts", "*.{ts,js}"],
    },
  },
}
