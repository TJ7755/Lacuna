{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": ["check", "fmt"],
  "workspaces": {
    ".": {
      "ignoreDependencies": [
        // Electron preparation invokes the compiler by filename; Tailwind loads through CSS.
        "@typescript/native",
        "tailwindcss",
        // Root runtime declaration is required by Electron packaging; desktop imports it.
        "electron-log",
        // Root installation supplies the AI workspace provider adapters.
        "@ai-sdk/gateway",
        "@ai-sdk/google",
        // Browser optimiser imports dynamic-wasi and its vendored worker imports the runtime.
        "@napi-rs/wasm-runtime",
        "@open-spaced-repetition/binding",
        // Root installation supplies web analytics, relay storage and AI request lifetimes.
        "@vercel/analytics",
        "@vercel/blob",
        "@vercel/functions",
        // Web dynamic imports load sanitisation and QR scanning; verification imports mathjs/number.
        "dompurify",
        "html5-qrcode",
        "mathjs",
      ],

      "entry": [
        // Vercel invokes this through ignoreCommand rather than a module import.
        "scripts/vercel-ignore-build.mjs",
        // Standalone evaluation and MCP consent smoke commands are invoked manually.
        "scripts/jev-evaluation.ts",
        "scripts/mcp-smoke.mjs",
        "scripts/mcp-smoke-click-allow.mjs",
        // Manually invoked performance runners and their alternate Playwright configuration.
        "scripts/electron-performance/startup.ts",
        "scripts/performance-course-loading/run.mjs",
        "tests/performance/playwright.study-load.config.ts",
        // Playwright specs pass these paths to esbuild entryPoints at runtime.
        "tests/e2e/fixtures/{jevStudy,reportContinuation,studyFirstGrade,studyImageAdvance,studySessionLoad}.ts",
        "scripts/{ai-benchmark,jev-smoke,question-bank,library-publish}.ts",
        "scripts/performance-heavy/{fixture,run}.ts",
        "scripts/performance-heavy/{summarise,trace-summary}.mjs",
        "tooling/semantic-answer-match/scripts/compare_answer_baseline.ts",
        "scripts/**/*.test.mjs",
        "tests/config/{playwright.*,vitest.recovery,vitest.risk}.config.ts",
        "tests/e2e/**/*.spec.ts",
        "tests/e2e-electron/**/*.spec.ts",
      ],
      "project": [
        "*.{js,mjs,cjs,ts,mts,cts}",
        "{apps,packages,scripts,tests}/**/*.{js,mjs,cjs,ts,tsx,mts,cts,css}",
        "tooling/semantic-answer-match/scripts/*.ts",
        "!apps/desktop/dist-electron/**",
      ],
      "vite": {
        "config": ["vite.config.ts", "vite.gaps.config.ts", "vite.library.config.ts"],
      },
    },
    "apps/relay": {
      "entry": ["api/index.ts", "tests/**/*.test.ts"],
      "project": ["{src,api,shared,tests,scripts}/**/*.{ts,mjs}", "*.{ts,mjs}"],
    },
    "tooling/handwriting-maths": {
      "entry": ["src/**/*.test.ts"],
      "project": ["src/**/*.ts", "*.ts"],
    },
    "tooling/lacuna-ai-mcp": {
      "entry": ["src/index.ts", "src/**/*.test.ts"],
      "project": ["src/**/*.ts", "*.{ts,js}"],
    },
    "apps/web": {
      "entry": [
        "src/pages/{quizlet,courses}/entry-client.tsx",
        "src/{teacher,library}/main.tsx",
        "src/pages/{landing,quizlet,courses}/entry-server.tsx",
        "src/workers/*.worker.ts",
        "src/fsrs/wasi-worker-browser.mjs",
        "src/{vite-env,testing}.d.ts",
        "src/**/*.test.{ts,tsx}",
        "src/main.tsx",
        "src/pages/landing/entry-client.tsx",
      ],
      "project": ["**/*.{js,mjs,cjs,ts,tsx,mts,cts,css}", "!dist*/**"],
    },
    "apps/desktop": {
      "entry": [
        "{main,preload}.ts",
        "mcp/{server,companion,aiCompanion,aiCompanionEntry}.ts",
        "updaterContract.d.ts",
      ],
      "project": ["**/*.{js,mjs,cjs,ts,tsx,mts,cts,css}", "!dist*/**"],
    },
    "apps/ai": {
      "entry": ["api/ai/*.ts", "server/ai/localSpike.ts"],
      "project": ["**/*.{js,mjs,cjs,ts,tsx,mts,cts,css}", "!dist*/**"],
    },
    "apps/gaps": {
      "entry": ["sw.js"],
      "project": ["**/*.{js,mjs,cjs,ts,tsx,mts,cts,css}", "!dist*/**"],
    },
  },
}
