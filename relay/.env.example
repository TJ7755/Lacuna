# Required. POST /channel is refused until this is a non-empty value.
# Generate with: openssl rand -hex 32
# Set the same name on the Vercel project. Never commit the real value.
RELAY_MINT_SECRET=

# Connected Vercel store: BLOB_STORE_ID, VERCEL_OIDC_TOKEN and
# BLOB_WEBHOOK_PUBLIC_KEY are injected automatically. Nothing to set.
#
# Off Vercel (self-hosting these functions against a Blob store), set:
BLOB_READ_WRITE_TOKEN=
