{
  "ignoreCommand": "node ../../scripts/vercel-ignore-build.mjs relay",
  "installCommand": "cd ../.. && node apps/relay/scripts/security-bun.mjs install --frozen-lockfile",
  "rewrites": [
    {
      "source": "/:path*",
      "destination": "/api?__path=/:path*"
    }
  ],
  "crons": [
    {
      "path": "/ai/maintenance",
      "schedule": "0 3 * * *"
    }
  ]
}
