# Optional. POST /channel is public and rate-limited when this is unset.
# Set this to add a private bearer-token bypass to the mint limit.
# Generate with: openssl rand -hex 32. Never commit the real value.
RELAY_MINT_SECRET=

# Connected Vercel store: BLOB_STORE_ID, VERCEL_OIDC_TOKEN and
# BLOB_WEBHOOK_PUBLIC_KEY are injected automatically. Nothing to set.
#
# Off Vercel (self-hosting these functions against a Blob store), set:
BLOB_READ_WRITE_TOKEN=
